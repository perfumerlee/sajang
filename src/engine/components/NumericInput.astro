---
type NumericKind = 'money' | 'percentage' | 'number' | 'days' | 'quantity';
interface Props {
  id: string;
  label: string;
  kind: NumericKind;
  description?: string;
  unit?: string;
  required?: boolean;
  defaultValue?: number;
  min?: number;
  max?: number;
  step?: number;
  error?: string;
}

const { id, label, kind, description, unit, required = false, defaultValue, min, max, step = 'any', error } = Astro.props;
const descriptionId = description ? `${id}-description` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [descriptionId, errorId].filter(Boolean).join(' ') || undefined;
---

<div class="engine-input-field">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  {description && <p id={descriptionId} class="engine-small">{description}</p>}
  <div class="engine-input-control">
    <input
      id={id}
      name={id}
      type="number"
      inputmode={kind === 'percentage' || kind === 'number' || kind === 'quantity' || kind === 'days' ? 'decimal' : 'decimal'}
      value={defaultValue}
      min={min}
      max={max}
      step={step}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
    />
    {unit && <span aria-hidden="true">{unit}</span>}
  </div>
  {error && <p id={errorId} role="alert" class="engine-input-error">{error}</p>}
</div>
