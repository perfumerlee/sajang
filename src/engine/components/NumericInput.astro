---
type NumericKind = 'money' | 'percentage' | 'number' | 'days' | 'quantity';
interface Props {
  id: string;
  label: string;
  kind: NumericKind;
  description?: string;
  unit?: string;
  required?: boolean;
  defaultValue?: number;
  min?: number;
  max?: number;
  step?: number;
  error?: string;
}

const { id, label, kind, description, unit, required = false, defaultValue, min, max, step = 'any', error } = Astro.props;
const descriptionId = description ? `${id}-description` : undefined;
const errorId = `${id}-error`;
const describedBy = [descriptionId, error ? errorId : undefined].filter(Boolean).join(' ') || undefined;
const displayValue = defaultValue === undefined ? undefined : kind === 'money' ? defaultValue.toLocaleString('ko-KR') : defaultValue;
---

<div class="engine-input-field" data-input-field={id}>
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  {description && <p id={descriptionId} class="engine-small">{description}</p>}
  <div class="engine-input-control">
    <input
      id={id}
      name={id}
      type={kind === 'money' ? 'text' : 'number'}
      inputmode={kind === 'percentage' || kind === 'number' || kind === 'quantity' || kind === 'days' ? 'decimal' : 'decimal'}
      value={displayValue}
      data-money-input={kind === 'money' ? 'true' : undefined}
      min={min}
      max={max}
      step={step}
      required={required}
      aria-invalid={error ? 'true' : 'false'}
      aria-describedby={describedBy}
      data-description-id={descriptionId}
      data-error-id={errorId}
    />
    {unit && <span aria-hidden="true">{unit}</span>}
  </div>
  <p id={errorId} data-input-error role="alert" class="engine-input-error" hidden>{error}</p>
</div>

{kind === 'money' && <script>
  const formatMoneyInput = (input: HTMLInputElement) => {
    const raw = input.value.replaceAll(',', '').replace(/[^\d.-]/g, '');
    if (raw === '' || raw === '-') return;
    const [integer, decimal] = raw.split('.');
    input.value = `${Number(integer).toLocaleString('ko-KR')}${decimal !== undefined ? `.${decimal}` : ''}`;
  };
  document.querySelectorAll<HTMLInputElement>('[data-money-input="true"]').forEach((input) => {
    input.addEventListener('focus', () => { input.value = input.value.replaceAll(',', ''); });
    input.addEventListener('input', () => formatMoneyInput(input));
    input.addEventListener('blur', () => formatMoneyInput(input));
  });
</script>}
