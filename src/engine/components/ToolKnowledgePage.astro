---
import type { SourceDefinition, ToolDefinition } from '../contracts';

interface Props {
  tool: ToolDefinition;
  projectName: string;
  categoryName: string;
  sources: SourceDefinition[];
  relatedTools?: ToolDefinition[];
}

const { tool, projectName, categoryName, sources, relatedTools = [] } = Astro.props;
const sourceById = new Map(sources.map((source) => [source.id, source]));
const formatValue = (value: number | string | boolean) => typeof value === 'number' ? value.toLocaleString() : String(value);
---

<article class="engine-knowledge-page">
  <nav aria-label="Breadcrumb" class="engine-small">
    <a href="/">{projectName}</a>
    <span aria-hidden="true"> / </span>
    <span>{categoryName}</span>
    <span aria-hidden="true"> / </span>
    <span>{tool.search.name}</span>
  </nav>

  <header class="engine-knowledge-header">
    <p class="engine-small">{tool.search.question}</p>
    <h1 class="engine-h1">{tool.search.title}</h1>
    <p>{tool.search.description}</p>
  </header>

  <section aria-labelledby="quick-answer" class="engine-section">
    <h2 id="quick-answer" class="engine-h2">빠른 답변</h2>
    <p>{tool.knowledge.shortAnswer}</p>
  </section>

  <slot name="calculator" />

  <div class="engine-reading engine-knowledge-prose">

  <section aria-labelledby="definition" class="engine-section">
    <h2 id="definition" class="engine-h2">정의와 작동 방식</h2>
    <h3 class="engine-h3">정의</h3>
    <p>{tool.knowledge.definition}</p>
    <h3 class="engine-h3">작동 방식</h3>
    <p>{tool.knowledge.howItWorks}</p>
  </section>

  <section aria-labelledby="formula" class="engine-section">
    <h2 id="formula" class="engine-h2">공식</h2>
    <pre class="engine-formula"><code>{tool.knowledge.formula}</code></pre>
  </section>

  <section aria-labelledby="example" class="engine-section">
    <h2 id="example" class="engine-h2">검증된 예시</h2>
    <p>{tool.knowledge.example.title}</p>
    <dl>
      {Object.entries(tool.knowledge.example.inputs).map(([label, value]) => (
        <div><dt>{label}</dt><dd class="engine-numeric">{formatValue(value)}</dd></div>
      ))}
    </dl>
    <h3 class="engine-h3">결과</h3>
    <dl>
      {Object.entries(tool.knowledge.example.result).map(([label, value]) => (
        <div><dt>{label}</dt><dd class="engine-numeric">{formatValue(value)}</dd></div>
      ))}
    </dl>
    <p>{tool.knowledge.example.explanation}</p>
  </section>

  <section aria-labelledby="limitations" class="engine-section">
    <h2 id="limitations" class="engine-h2">한계</h2>
    <ul>
      {tool.knowledge.limitations.map((limitation) => <li>{limitation}</li>)}
    </ul>
  </section>

  <section aria-labelledby="faq" class="engine-section">
    <h2 id="faq" class="engine-h2">자주 묻는 질문</h2>
    {tool.knowledge.faq.map((item) => (
      <div>
        <h3 class="engine-h3">{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>

  {(relatedTools.length > 0 || (tool.relations.relatedDecisions?.length ?? 0) > 0) && (
    <section aria-labelledby="related-tools" class="engine-section">
      <h2 id="related-tools" class="engine-h2">관련 도구</h2>
      <ul>
        {relatedTools.map((related) => <li><a href={`/tools/${related.identity.slug}/`}>{related.search.name}</a></li>)}
        {tool.relations.relatedDecisions?.map((related) => <li>{related.question} — {related.label}</li>)}
      </ul>
    </section>
  )}

  <footer class="engine-section engine-small">
    <h2 class="engine-h3">출처 및 검토 정보</h2>
    <ul>
      {tool.relations.sources.map((sourceId) => {
        const source = sourceById.get(sourceId);
        return source ? <li>{source.url ? <a href={source.url}>{source.title}</a> : source.title}</li> : null;
      })}
    </ul>
    <p>마지막 검토일: <time datetime={tool.maintenance.reviewedAt}>{tool.maintenance.reviewedAt}</time></p>
  </footer>
  </div>
</article>
