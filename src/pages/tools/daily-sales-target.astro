---
import SiteHeader from '../../engine/components/SiteHeader.astro';
import ToolKnowledgePage from '../../engine/components/ToolKnowledgePage.astro';
import SeoHead from '../../engine/components/SeoHead.astro';
import MoneyInput from '../../engine/components/MoneyInput.astro';
import PercentageInput from '../../engine/components/PercentageInput.astro';
import DaysInput from '../../engine/components/DaysInput.astro';
import Result from '../../engine/components/Result.astro';
import { validateProjectDefinition } from '../../engine/validation';
import { dailySalesTargetProject, dailySalesTargetSources, dailySalesTargetTool } from '../../projects/sajang/tools/daily-sales-target/definition';
import { calculateDailySalesTarget, formatPercent, formatWon } from '../../projects/sajang/tools/daily-sales-target/calculator';
import '../../engine/styles/foundation.css';
import '../../projects/sajang/styles/daily-sales-target.css';
import { resolveRelatedTools } from '../../projects/sajang/tools/registry';

validateProjectDefinition(dailySalesTargetProject, (id) => id === 'daily-sales-target' ? () => calculateDailySalesTarget : undefined);
const exampleInput = { fixedCost: 4_000_000, variableRate: 0.35, operatingDays: 26, targetProfit: 3_000_000 };
const exampleResult = calculateDailySalesTarget(exampleInput);

import SajangAnalytics from '../../projects/sajang/analytics/SajangAnalytics.astro';
import SajangGtmHead from '../../projects/sajang/analytics/SajangGtmHead.astro';
---

<!doctype html>
<html lang="ko">
  <head><SajangGtmHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{dailySalesTargetTool.search.title}</title>
    <meta name="description" content={dailySalesTargetTool.search.description} />
    <SeoHead tool={dailySalesTargetTool} projectName="사장도구" categoryName="매출" path={`/tools/${dailySalesTargetTool.identity.slug}/`} siteUrl={import.meta.env.PUBLIC_SITE_URL} basePath={import.meta.env.BASE_URL} />
  </head>
  <body><SajangAnalytics /><SiteHeader brand="사장도구" />
    <main class="engine-container engine-calculator">
      <ToolKnowledgePage showHeader={false} tool={dailySalesTargetTool} projectName="사장도구" categoryName="매출" sources={dailySalesTargetSources} relatedTools={resolveRelatedTools(dailySalesTargetTool)}>
        <section slot="calculator" aria-labelledby="calculator-inputs" class="engine-calculator daily-sales-layout">
          <section class="daily-sales-input-panel">
            <h2 id="calculator-inputs" class="engine-h2">계산 조건</h2>
            <form data-daily-sales-target-form>
              <MoneyInput id="fixedCost" label="매출이 없어도 매달 나가는 비용" description="임대료, 인건비처럼 매출과 상관없이 매달 부담하는 비용을 입력하세요." required min={0} defaultValue={exampleInput.fixedCost} />
              <PercentageInput id="variableRate" label="매출 100원 중 비용으로 나가는 비율" description="재료비·판매 수수료처럼 매출이 늘면 함께 늘어나는 비용의 비율입니다." required defaultValue={35} />
              <DaysInput id="operatingDays" label="한 달에 영업하는 날" description="한 달 동안 실제로 영업하는 날을 입력하세요." required max={31} defaultValue={exampleInput.operatingDays} />
              <MoneyInput id="targetProfit" label="고정비를 내고 남기고 싶은 금액" description="고정비를 모두 낸 뒤 한 달에 추가로 남기고 싶은 금액입니다." required min={0} defaultValue={exampleInput.targetProfit} />
              <MoneyInput id="averageOrderValue" label="한 번 결제할 때 평균 금액" description="선택 입력. 하루 목표 매출에 필요한 고객·주문 수를 계산합니다." min={0} />
              <button class="engine-button" type="submit">계산하기</button>
              <p data-calculator-error class="engine-input-error" role="alert" hidden></p>
            </form>
          </section>
          <section aria-labelledby="calculator-result" class="daily-sales-result-panel">
            <h2 id="calculator-result" class="engine-h2">계산 결과</h2>
            <Result variant="primary" label="하루 평균 목표 매출" value={formatWon(exampleResult.targetDaily).replace(/원$/, '')} unit="원" id="target-daily-result" />
            <p class="daily-sales-meaning">입력한 비용과 목표 금액을 충당하려면 하루에 필요한 매출입니다.</p>
            <dl class="daily-sales-results">
              <div><dt>목표 월매출</dt><dd data-result="targetMonthly" class="engine-numeric">{formatWon(exampleResult.targetMonthly)}</dd></div>
              <div><dt>손익분기 월매출</dt><dd data-result="breakEvenMonthly" class="engine-numeric">{formatWon(exampleResult.breakEvenMonthly)}</dd></div>
              <div><dt>손익분기 일매출</dt><dd data-result="breakEvenDaily" class="engine-numeric">{formatWon(exampleResult.breakEvenDaily)}</dd></div>
              <div><dt>비용을 제외하고 남는 비율</dt><dd data-result="contributionRate" class="engine-numeric">{formatPercent(exampleResult.contributionRate)}</dd></div>
              <div><dt>필요 고객/주문 수</dt><dd data-result="customersNeeded" class="engine-numeric">객단가 입력 시 계산</dd></div>
            </dl>
          </section>
        </section>
      </ToolKnowledgePage>
    </main>
  </body>
</html>

<script src="../../projects/sajang/tools/daily-sales-target/client.ts"></script>
