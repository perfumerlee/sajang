---
import SiteHeader from '../../engine/components/SiteHeader.astro';
import ToolKnowledgePage from '../../engine/components/ToolKnowledgePage.astro';
import SeoHead from '../../engine/components/SeoHead.astro';
import MoneyInput from '../../engine/components/MoneyInput.astro';
import PercentageInput from '../../engine/components/PercentageInput.astro';
import QuantityInput from '../../engine/components/QuantityInput.astro';
import Result from '../../engine/components/Result.astro';
import { validateProjectDefinition } from '../../engine/validation';
import { discountProfitProject, discountProfitSources, discountProfitTool } from '../../projects/sajang/tools/discount-profit/definition';
import { calculateDiscountProfit, formatPercent, formatQuantity, formatWon } from '../../projects/sajang/tools/discount-profit/calculator';
import '../../engine/styles/foundation.css';
import '../../projects/sajang/styles/discount-profit.css';
validateProjectDefinition(discountProfitProject, (id) => id === 'discount-profit' ? () => calculateDiscountProfit : undefined);
const exampleInput = { regularPrice: 20_000, currentQuantity: 100, unitCost: 10_000, fixedSellingCost: 1_000, percentageFee: 0.05, discountRate: 0.1 };
const exampleResult = calculateDiscountProfit(exampleInput);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{discountProfitTool.search.title}</title><meta name="description" content={discountProfitTool.search.description} /><SeoHead tool={discountProfitTool} projectName="사장도구" categoryName="할인 손익" path="/tools/discount-profit/" siteUrl={import.meta.env.PUBLIC_SITE_URL} basePath={import.meta.env.BASE_URL} /></head><body><SiteHeader brand="사장도구" /><main class="engine-container engine-calculator"><ToolKnowledgePage showHeader={false} tool={discountProfitTool} projectName="사장도구" categoryName="할인 손익" sources={discountProfitSources}><section slot="calculator" class="engine-calculator discount-profit-layout" data-discount-profit-tool><section class="discount-profit-input-panel"><h2 class="engine-h2">할인 조건</h2><p class="engine-small">현재 판매량은 할인 전 기준이며 같은 비교 기간의 판매량입니다.</p><form data-discount-profit-form><MoneyInput id="regularPrice" label="할인 전 판매가격" required min={0} defaultValue={20000} /><QuantityInput id="currentQuantity" label="할인 전 판매량" required min={1} defaultValue={100} /><MoneyInput id="unitCost" label="상품 하나에 드는 비용" required min={0} defaultValue={10000} /><MoneyInput id="fixedSellingCost" label="한 건 팔 때 별도로 드는 비용" required min={0} defaultValue={1000} /><PercentageInput id="percentageFee" label="판매할 때 빠지는 수수료 비율" required defaultValue={5} /><PercentageInput id="discountRate" label="얼마나 할인할지" required max={100} defaultValue={10} /><button class="engine-button" type="submit">계산하기</button><p data-calculator-error class="engine-input-error" role="alert" hidden></p></form></section><section class="discount-profit-result-panel" aria-labelledby="discount-profit-result"><h2 id="discount-profit-result" class="engine-h2">계산 결과</h2><Result variant="primary" label="현재 총 남는 금액을 유지하기 위한 필요한 판매량" value={formatQuantity(exampleResult.requiredQuantity)} id="required-quantity-result" /><p data-calculator-meaning class="discount-profit-meaning">10% 할인 후 현재 총 남는 금액을 유지하려면 판매량이 {formatPercent(exampleResult.requiredIncreaseRate)} 증가해야 합니다.</p><dl class="discount-profit-results"><div><dt>할인 판매가격</dt><dd data-result="discountPrice" class="engine-numeric">{formatWon(exampleResult.discountPrice)}</dd></div><div><dt>할인 전 개당 남는 금액</dt><dd data-result="currentUnitContribution" class="engine-numeric">{formatWon(exampleResult.currentUnitContribution)}</dd></div><div><dt>할인 후 개당 남는 금액</dt><dd data-result="discountUnitContribution" class="engine-numeric">{formatWon(exampleResult.discountUnitContribution)}</dd></div><div><dt>할인 전 총 남는 금액</dt><dd data-result="currentTotalContribution" class="engine-numeric">{formatWon(exampleResult.currentTotalContribution)}</dd></div></dl></section></section></ToolKnowledgePage></main></body></html><script src="../../projects/sajang/tools/discount-profit/client.ts"></script>
