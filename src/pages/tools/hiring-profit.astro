---
import ToolKnowledgePage from '../../engine/components/ToolKnowledgePage.astro';
import SeoHead from '../../engine/components/SeoHead.astro';
import MoneyInput from '../../engine/components/MoneyInput.astro';
import PercentageInput from '../../engine/components/PercentageInput.astro';
import DaysInput from '../../engine/components/DaysInput.astro';
import Result from '../../engine/components/Result.astro';
import { validateProjectDefinition } from '../../engine/validation';
import { hiringProfitProject, hiringProfitSources, hiringProfitTool } from '../../projects/sajang/tools/hiring-profit/definition';
import { calculateHiringProfit, formatPercent, formatWon } from '../../projects/sajang/tools/hiring-profit/calculator';
import '../../engine/styles/foundation.css'; import '../../projects/sajang/styles/hiring-profit.css';
validateProjectDefinition(hiringProfitProject, (id) => id === 'hiring-profit' ? () => calculateHiringProfit : undefined);
const exampleInput = { employeeMonthlyCost: 3_000_000, variableRate: 0.35, operatingDays: 26, currentDailyRevenue: 500_000 }; const exampleResult = calculateHiringProfit(exampleInput);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{hiringProfitTool.search.title}</title><meta name="description" content={hiringProfitTool.search.description} /><SeoHead tool={hiringProfitTool} projectName="사장도구" categoryName="고용" path="/tools/hiring-profit/" siteUrl={import.meta.env.PUBLIC_SITE_URL} basePath={import.meta.env.BASE_URL} /></head><body><main class="engine-container"><ToolKnowledgePage tool={hiringProfitTool} projectName="사장도구" categoryName="고용" sources={hiringProfitSources}><section slot="calculator" class="engine-calculator hiring-profit-layout" data-hiring-profit-tool><section class="hiring-profit-input-panel"><h2 class="engine-h2">직원 고용 조건</h2><p class="engine-small">추가 직원 월 총비용은 실제로 월별 부담한다고 판단한 전체 비용을 직접 입력하세요. 현재 하루 평균 매출은 같은 비교 기간의 값입니다.</p><form data-hiring-profit-form><MoneyInput id="employeeMonthlyCost" label="추가 직원 월 총비용" required min={0} /><PercentageInput id="variableRate" label="평균 변동비율" required /><DaysInput id="operatingDays" label="월 영업일" required max={31} defaultValue={26} /><MoneyInput id="currentDailyRevenue" label="현재 하루 평균 매출 (선택)" min={0} /><button class="engine-button" type="submit">계산하기</button><p data-calculator-error class="engine-input-error" role="alert" hidden></p></form></section><section class="hiring-profit-result-panel" aria-labelledby="hiring-profit-result"><h2 id="hiring-profit-result" class="engine-h2">필요한 추가 매출</h2><Result variant="primary" label="하루 추가 필요 매출" value={formatWon(exampleResult.additionalDailyRevenue)} id="additional-daily-result" /><p data-calculator-meaning class="hiring-profit-meaning">직원 한 명의 월 총비용을 감당하려면 하루 평균 매출이 약 {formatWon(exampleResult.additionalDailyRevenue)} 더 필요합니다.</p><dl class="hiring-profit-results"><div><dt>추가 필요 월매출</dt><dd data-result="additionalMonthlyRevenue" class="engine-numeric">{formatWon(exampleResult.additionalMonthlyRevenue)}</dd></div><div><dt>입력한 직원 월 총비용</dt><dd class="engine-numeric">{formatWon(exampleInput.employeeMonthlyCost)}</dd></div><div><dt>기여율</dt><dd data-result="contributionRate" class="engine-numeric">{formatPercent(exampleResult.contributionRate)}</dd></div></dl></section></section></ToolKnowledgePage></main></body></html><script src="../../projects/sajang/tools/hiring-profit/client.ts"></script>
