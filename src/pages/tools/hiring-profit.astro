---
import SiteHeader from '../../engine/components/SiteHeader.astro';
import ToolKnowledgePage from '../../engine/components/ToolKnowledgePage.astro';
import SeoHead from '../../engine/components/SeoHead.astro';
import MoneyInput from '../../engine/components/MoneyInput.astro';
import PercentageInput from '../../engine/components/PercentageInput.astro';
import DaysInput from '../../engine/components/DaysInput.astro';
import Result from '../../engine/components/Result.astro';
import { validateProjectDefinition } from '../../engine/validation';
import { hiringProfitProject, hiringProfitSources, hiringProfitTool } from '../../projects/sajang/tools/hiring-profit/definition';
import { calculateHiringProfit, formatPercent, formatWon } from '../../projects/sajang/tools/hiring-profit/calculator';
import '../../engine/styles/foundation.css'; import '../../projects/sajang/styles/hiring-profit.css';
validateProjectDefinition(hiringProfitProject, (id) => id === 'hiring-profit' ? () => calculateHiringProfit : undefined);
const exampleInput = { employeeMonthlyCost: 3_000_000, variableRate: 0.35, operatingDays: 26, currentDailyRevenue: 500_000 }; const exampleResult = calculateHiringProfit(exampleInput);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{hiringProfitTool.search.title}</title><meta name="description" content={hiringProfitTool.search.description} /><SeoHead tool={hiringProfitTool} projectName="사장도구" categoryName="고용" path="/tools/hiring-profit/" siteUrl={import.meta.env.PUBLIC_SITE_URL} basePath={import.meta.env.BASE_URL} /></head><body><SiteHeader brand="사장도구" /><main class="engine-container engine-calculator"><ToolKnowledgePage showHeader={false} tool={hiringProfitTool} projectName="사장도구" categoryName="고용" sources={hiringProfitSources}><section slot="calculator" class="engine-calculator hiring-profit-layout" data-hiring-profit-tool><section class="hiring-profit-input-panel"><h2 class="engine-h2">직원 고용 조건</h2><p class="engine-small">직원 한 명을 추가하면서 매달 부담한다고 생각하는 전체 비용을 입력하세요. 현재 하루 평균 매출은 같은 비교 기간의 값입니다.</p><form data-hiring-profit-form><MoneyInput id="employeeMonthlyCost" label="직원 한 명을 추가할 때 매달 드는 비용" required min={0} defaultValue={3000000} /><PercentageInput id="variableRate" label="매출 100원 중 비용으로 나가는 비율" required defaultValue={35} /><DaysInput id="operatingDays" label="한 달에 영업하는 날" required max={31} defaultValue={26} /><MoneyInput id="currentDailyRevenue" label="현재 하루 평균 매출 (선택)" min={0} defaultValue={500000} /><button class="engine-button" type="submit">계산하기</button><p data-calculator-error class="engine-input-error" role="alert" hidden></p></form></section><section class="hiring-profit-result-panel" aria-labelledby="hiring-profit-result"><h2 id="hiring-profit-result" class="engine-h2">필요한 추가 매출</h2><Result variant="primary" label="하루 추가 필요 매출" value={formatWon(exampleResult.additionalDailyRevenue)} id="additional-daily-result" /><p data-calculator-meaning class="hiring-profit-meaning">직원 한 명의 월 총비용을 감당하려면 하루 평균 매출이 약 {formatWon(exampleResult.additionalDailyRevenue)} 더 필요합니다.</p><p class="engine-small hiring-profit-formula">계산 기준: 월 비용 ÷ (1 - 비용 비율) ÷ 월 영업일</p><dl class="hiring-profit-results"><div><dt>추가 필요 월매출</dt><dd data-result="additionalMonthlyRevenue" class="engine-numeric">{formatWon(exampleResult.additionalMonthlyRevenue)}</dd></div><div><dt>입력한 직원 월 총비용</dt><dd data-result="employeeMonthlyCost" class="engine-numeric">{formatWon(exampleInput.employeeMonthlyCost)}</dd></div><div><dt>비용을 빼고 남는 비율</dt><dd data-result="contributionRate" class="engine-numeric">{formatPercent(exampleResult.contributionRate)}</dd></div></dl></section></section></ToolKnowledgePage></main></body></html><script src="../../projects/sajang/tools/hiring-profit/client.ts"></script>
