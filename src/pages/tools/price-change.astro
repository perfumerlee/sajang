---
import ToolKnowledgePage from '../../engine/components/ToolKnowledgePage.astro';
import SeoHead from '../../engine/components/SeoHead.astro';
import MoneyInput from '../../engine/components/MoneyInput.astro';
import PercentageInput from '../../engine/components/PercentageInput.astro';
import QuantityInput from '../../engine/components/QuantityInput.astro';
import Result from '../../engine/components/Result.astro';
import { validateProjectDefinition } from '../../engine/validation';
import { priceChangeProject, priceChangeSources, priceChangeTool } from '../../projects/sajang/tools/price-change/definition';
import { calculatePriceChange, formatPercent, formatQuantity, formatWon } from '../../projects/sajang/tools/price-change/calculator';
import '../../engine/styles/foundation.css';
import '../../projects/sajang/styles/price-change.css';
validateProjectDefinition(priceChangeProject, (id) => id === 'price-change' ? () => calculatePriceChange : undefined);
const exampleInput = { currentPrice: 20_000, currentQuantity: 100, unitCost: 10_000, fixedSellingCost: 1_000, percentageFee: 0.05, newPrice: 23_000 };
const exampleResult = calculatePriceChange(exampleInput);
---
<!doctype html>
<html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{priceChangeTool.search.title}</title><meta name="description" content={priceChangeTool.search.description} /><SeoHead tool={priceChangeTool} projectName="사장도구" categoryName="가격 변경" path="/tools/price-change/" siteUrl={import.meta.env.PUBLIC_SITE_URL} basePath={import.meta.env.BASE_URL} /></head>
<body><main class="engine-container"><ToolKnowledgePage tool={priceChangeTool} projectName="사장도구" categoryName="가격 변경" sources={priceChangeSources}><section slot="calculator" class="engine-calculator price-change-layout" data-price-change-tool><section class="price-change-input-panel"><h2 class="engine-h2">가격 변경 조건</h2><p class="engine-small">현재 판매량과 예상 판매량은 같은 비교 기간을 기준으로 입력하세요.</p><form data-price-change-form><MoneyInput id="currentPrice" label="현재 판매가격" required min={0} /><QuantityInput id="currentQuantity" label="현재 판매량" required min={1} /><MoneyInput id="unitCost" label="단위 비용" required min={0} /><MoneyInput id="fixedSellingCost" label="고정 판매비" required min={0} /><PercentageInput id="percentageFee" label="판매 수수료율" required /><MoneyInput id="newPrice" label="변경 판매가격" required min={0} /><QuantityInput id="expectedQuantity" label="예상 판매량 (선택)" min={0} description="현재 판매량과 같은 비교 기간의 예상 수량입니다." /><button class="engine-button" type="submit">계산하기</button><p data-calculator-error class="engine-input-error" role="alert" hidden></p></form></section><section class="price-change-result-panel" aria-labelledby="price-change-result"><h2 id="price-change-result" class="engine-h2">계산 결과</h2><Result variant="primary" label="현재 총 기여금 유지를 위한 필요한 판매량" value={formatQuantity(exampleResult.requiredQuantity)} id="required-quantity-result" /><p data-calculator-meaning class="price-change-meaning">현재 총 기여금을 유지하려면 판매량이 {formatPercent(Math.abs(exampleResult.quantityChangeRate))} 감소해도 됩니다.</p><dl class="price-change-results"><div><dt>현재 개당 기여금</dt><dd data-result="currentUnitContribution" class="engine-numeric">{formatWon(exampleResult.currentUnitContribution)}</dd></div><div><dt>변경 후 개당 기여금</dt><dd data-result="newUnitContribution" class="engine-numeric">{formatWon(exampleResult.newUnitContribution)}</dd></div><div><dt>현재 총 기여금</dt><dd data-result="currentTotalContribution" class="engine-numeric">{formatWon(exampleResult.currentTotalContribution)}</dd></div><div><dt>변경 후 예상 총 기여금</dt><dd data-result="expectedTotalContribution" class="engine-numeric">예상 판매량 입력 시 계산</dd></div><div><dt>현재 총 기여금 대비 증감액</dt><dd data-result="contributionChange" class="engine-numeric">예상 판매량 입력 시 계산</dd></div></dl><p class="engine-small">가격 변경 후 실제 판매량은 수요 예측이 아니라 입력 조건 기준으로 비교합니다.</p></section></section></ToolKnowledgePage></main></body></html>
<script src="../../projects/sajang/tools/price-change/client.ts"></script>
